{{$useHTMX := not .NewIssuePage}}
{{if or .OpenProjects .ClosedProjects}}
	<div class="ui icon search input">
		<i class="icon">{{svg "octicon-search" 16}}</i>
		<input type="text" placeholder="{{ctx.Locale.Tr "repo.issues.filter_projects"}}">
	</div>
	<div class="divider"></div>
{{end}}
{{template "repo/issue/project/clear_project" dict "." . "UseHTMX" $useHTMX}}
{{if and (not .OpenProjects) (not .ClosedProjects)}}
	<div class="disabled item">
		{{ctx.Locale.Tr "repo.issues.new.no_items"}}
	</div>
{{else}}
	{{if .OpenProjects}}
		<div class="divider"></div>
		<div class="header">
			{{ctx.Locale.Tr "repo.issues.new.open_projects"}}
		</div>
		{{range .OpenProjects}}
			<a class="item muted sidebar-item-link"{{if $useHTMX}} hx-post="{{$.RepoLink}}/issues/projects?id={{.ID}}&issue_ids={{$.Issue.ID}}&htmx=true"{{else}} data-id="{{.ID}}" data-href="{{.Link ctx}}"{{end}}>
				{{svg .IconName 16 "tw-mr-2"}}{{.Title}}
			</a>
		{{end}}
	{{end}}
	{{if .ClosedProjects}}
		<div class="divider"></div>
		<div class="header">
			{{ctx.Locale.Tr "repo.issues.new.closed_projects"}}
		</div>
		{{range .ClosedProjects}}
			<a class="item muted sidebar-item-link"{{if $useHTMX}} hx-post="{{$.RepoLink}}/issues/projects?id={{.ID}}&issue_ids={{$.Issue.ID}}&htmx=true"{{else}} data-id="{{.ID}}" data-href="{{.Link ctx}}"{{end}}>
				{{svg .IconName 16 "tw-mr-2"}}{{.Title}}
			</a>
		{{end}}
	{{end}}
{{end}}
